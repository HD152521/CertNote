# Neon Postgres 연결 문자열 (pooled 권장)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 세션 JWT 서명 키 (16자 이상의 충분히 긴 임의 문자열)
JWT_SECRET=please-change-to-a-long-random-secret

# 최초 관리자 계정 (npm run db:seed 로 생성)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-8plus

# 비밀번호 재설정 메일 발송. RESEND_API_KEY 미설정 시 콘솔에 링크 출력(로컬 개발).
RESEND_API_KEY=
MAIL_FROM=CertNote <onboarding@resend.dev>
# 메일의 재설정 링크에 쓰일 사이트 절대 URL
APP_URL=http://localhost:3000

# --- Web Push (PWA 알림) ---
# VAPID 키 생성: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# 공개키는 클라이언트 구독에 필요(공개돼도 안전). VAPID_PUBLIC_KEY와 동일 값.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 알림 발송 크론 보호용 시크릿(임의의 긴 문자열). 크론 요청 헤더로 검증.
CRON_SECRET=

# --- AI 오답 튜터 (로그인 사용자 누구나) ---
# Anthropic API 키. 미설정 시 튜터는 503으로 비활성(앱 나머지는 정상).
ANTHROPIC_API_KEY=
# 튜터 모델(선택). 비용·속도 위해 claude-haiku-4-5 권장(미설정 시 기본 claude-opus-4-8).
TUTOR_MODEL=claude-haiku-4-5
# 유저별 AI 튜터 일일 호출 상한(비용 보호). 미설정 시 기본 3.
TUTOR_DAILY_LIMIT=3

# --- 소셜 로그인 (Google OAuth) ---
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹).
# 승인된 리디렉션 URI에 다음 둘을 등록:
#   https://cert-note.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# 미설정 시 구글 로그인 버튼이 표시되지 않는다(나머지 기능 정상).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 에러 추적 (Sentry) ---
# 프로젝트 DSN. 미설정 시 에러 추적 완전 비활성(no-op). 프로덕션에서만 동작.
# sentry.io → 프로젝트 생성(Next.js) → Settings → Client Keys(DSN)
NEXT_PUBLIC_SENTRY_DSN=
# 아래 3개는 빌드 시 소스맵 업로드용(선택). 없어도 에러 수집은 되고 스택만 난독화됨.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- 제품 분석 (PostHog) ---
# 프로젝트 API 키. 미설정 시 분석 완전 비활성(no-op). 프로덕션에서만 동작.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog 호스트. 미국 https://us.i.posthog.com / EU https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- 광고 (Google AdSense) ---
# 게시자 ID. 형식은 ca-pub- 뒤에 숫자 16자리(애드센스 → 계정 → 계정 정보).
# 미설정이거나 형식이 틀리면 광고 스크립트·광고 슬롯을 렌더하지 않고 /ads.txt 는 404 를 낸다.
# 설정하면 공개 페이지에만 로더가 실리고(로그인 전용·인증·구독 화면 제외) /ads.txt 가 이 값으로 생성된다.
# NEXT_PUBLIC_* 는 빌드 때 인라인되므로 값을 바꾸면 다시 빌드(재배포)해야 한다.
NEXT_PUBLIC_ADSENSE_CLIENT=
# 광고 단위(슬롯) ID — 위치별로 하나씩. 애드센스 승인 뒤 콘솔(광고 → 광고 단위 기준 → 디스플레이 광고,
# 크기 "반응형")에서 만들고, 코드의 data-ad-slot 숫자만 넣는다. 이름과 크기는 src/lib/ads/adPlacements.ts 참고.
# 게시자 ID 가 없으면 전부 무시된다. 게시자 ID 는 있는데 특정 값만 비어 있으면 그 자리만 렌더하지 않는다.
#   DAY_TOP    본문 페이지 — 요약 카드 아래·본문 시작 전 (가로 배너, 높이 100px)
#   DAY_BOTTOM 본문 페이지 — 본문 끝·이전/다음 위 (사각형, 높이 280px. 광고가 안 채워지면 접힌다)
#   HUB        자격증 허브 — 주차 목록 위 (가로 배너, 높이 100px)
# 영어판 2주차 이상(noindex)·홈·후기·인증 화면에는 값이 있어도 슬롯을 두지 않는다.
NEXT_PUBLIC_ADSENSE_SLOT_DAY_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_DAY_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_HUB=
# 운영 메모
# - Vercel 에서는 위 4개를 Production 환경에만 넣는다. Preview 에 넣으면 미리보기 배포에서 실제 광고
#   요청이 나가 무효 트래픽으로 잡힐 수 있다.
# - 애드센스 콘솔의 자동 광고(Auto ads)는 켜지 않는 것을 기본으로 한다. 로더는 "찾을 수 없음" 화면
#   (200 + noindex 로 나가는 소프트 404)에도 실려, 자동 광고를 켜면 본문 없는 화면에 광고가 뜰 수 있다.
