{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "questions:build": "node scripts/build-questions-index.mjs",
    "exam:build": "node scripts/build-exam-index.mjs",
    "prebuild": "node scripts/build-questions-index.mjs && node scripts/build-exam-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env scripts/db-seed-admin.mjs",
    "grant:pro": "node --env-file=.env scripts/grant-pro.mjs",
    "qa:questions": "node --env-file=.env scripts/qa-questions.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@sentry/nextjs": "^10.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "posthog-js": "^1.396.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
